# Copy to .docker.env; never commit the filled file or paste tokens into chat.
# Set independent random values of at least 24 characters for both secrets.
HARNESS_TOKEN=
CREDENTIAL_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional exact additional Host authorities, only in explicit container mode.
HARNESS_ALLOWED_HOSTS=
# Optional owner-trusted literal loopback MCP endpoints inside this container.
# The MCP registry validates these; this is not a general private-network bypass.
MCP_TRUSTED_LOCAL_URLS=
